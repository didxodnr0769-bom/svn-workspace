{
  "name": "svn-workspace",
  "version": "0.1.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A focused personal SVN client for macOS",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run licenses:check && node scripts/build.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs --write",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "postinstall": "install-electron",
    "test:renderer": "npm run build && node tests/renderer-regression.mjs --resize",
    "test:folders": "npm run build && node tests/folder-deletion-renderer.mjs",
    "test:projects": "npm run build && node tests/project-management-renderer.mjs",
    "test:revert": "npm run build && node tests/revert-renderer.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "com.taewook.svnworkspace",
    "productName": "SVN Workspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE.svn-workspace.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "licenses/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "SVN Workspace"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Taewook"
}
